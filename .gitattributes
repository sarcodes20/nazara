# Normalise to LF in the repository; check out native on Windows.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ico binary

# Generated by scripts/generate-placeholders.mjs; keep diffs out of review.
public/images/generated/** linguist-generated=true

# The three volumes are reference documents, not source.
docs/*.html linguist-documentation=true
